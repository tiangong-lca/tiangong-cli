{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tiangong-lca:cli-runtime-descriptor:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "package",
    "platform",
    "node",
    "command",
    "assets",
    "files",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "tiangong-lca.cli-runtime-descriptor.v1"
    },
    "scope": {
      "const": "cli-package"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "root", "manifest_sha256"],
      "properties": {
        "name": {
          "const": "@tiangong-lca/cli"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "platform": {
      "enum": ["darwin-arm64", "linux-x64", "linux-arm64", "win32-x64"]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "executable", "bytes", "sha256"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^24\\.(?:19|[2-9][0-9]|[1-9][0-9]{2,})\\.(?:0|[1-9][0-9]*)$"
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "argv"],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tidas_schema_root", "sha256"],
      "properties": {
        "tidas_schema_root": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 536870912
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
